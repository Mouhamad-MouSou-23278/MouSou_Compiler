# ==============================================================================
# Online Compiler V2 - Environment Configuration Template
# ==============================================================================

# Database (PostgreSQL)
POSTGRES_DB=online_compiler
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# In-memory / Distributed Cache & Queue (Redis)
REDIS_PORT=6379

# Web API Configuration
API_PORT=5000
ASPNETCORE_ENVIRONMENT=Production

# Security & Authentication (Change in production!)
JWT_SECRET=SuperSecretEnterpriseProductionKeyMouSouCompiler2026!
JWT_ISSUER=OnlineCompilerV2
JWT_AUDIENCE=OnlineCompilerV2Client
JWT_EXPIRY_MINUTES=60

# AI-Assisted Development (OpenRouter)
# Get a free key at https://openrouter.ai/keys
# Free models supported:
# - meta-llama/llama-3.2-3b-instruct:free
# - google/gemini-2.0-flash-exp:free
# - mistralai/mistral-7b-instruct:free
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions

# Code Execution Sandbox Engine
EXECUTION_TIMEOUT_SECONDS=15
SANDBOX_MEMORY_LIMIT_MB=256
SANDBOX_CPU_LIMIT=1.0

# Frontend Web Application
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000
VITE_API_URL=http://localhost:5000
